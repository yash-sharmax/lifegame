rules_version = '2';

// Life Game (Flutter v2) — Firestore security rules.
// Deploy with the Firebase CLI (`firebase deploy --only firestore:rules`)
// or paste into the Firebase console: Firestore Database -> Rules.
//
// SECURITY MODEL (see FIREBASE.md for the full write-up, incl. the honest
// residual risk): the client is never trusted with arbitrary XP.
//  - Profiles are readable by any signed-in user (leaderboard / search /
//    public profile) but writable only by the owner, and the username
//    can never be changed after creation.
//  - XP / streak fields are capped per write: XP may move at most 60 in
//    either direction (a tick is +10, the daily bonus +50, an untick -10),
//    currentStreak at most +/-1, longestStreak only up, at most +1.
//  - lastActiveDate may only change together with a streak change.
//  - Habits / logs / tasks are owner-only.
//  - Follows can only be created/deleted by the follower; no self-follows.
//  - Username docs are create-only, owned by the uid, and can never be
//    updated or deleted (first come, first served).
// Full server-side enforcement (a Cloud Function that awards XP) is a
// future hardening step — it needs the Blaze plan. Until then a determined
// attacker with a modified client can still grind XP in +60 steps; the
// caps only make that slow and visible, they do not make it impossible.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Keys changed by this update.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- XP / streak caps (users/{uid} updates) ---

    function xpDeltaOk() {
      return request.resource.data.xp is int
          && resource.data.xp is int
          && request.resource.data.xp >= 0
          && request.resource.data.xp >= resource.data.xp - 60
          && request.resource.data.xp <= resource.data.xp + 60;
    }

    function streakDeltaOk() {
      return request.resource.data.currentStreak is int
          && request.resource.data.longestStreak is int
          && request.resource.data.currentStreak >= 0
          && request.resource.data.longestStreak >= 0
          && request.resource.data.currentStreak
              >= resource.data.currentStreak - 1
          && request.resource.data.currentStreak
              <= resource.data.currentStreak + 1
          && request.resource.data.longestStreak
              >= resource.data.longestStreak
          && request.resource.data.longestStreak
              <= resource.data.longestStreak + 1;
    }

    // lastActiveDate only moves when the streak moves (a tick/untick
    // always moves the streak when it moves the date).
    function lastActiveOk() {
      return !changedKeys().hasAny(['lastActiveDate'])
          || resource.data.currentStreak
              != request.resource.data.currentStreak;
    }

    // --- Profiles ---

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.xp == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.longestStreak == 0
        && request.resource.data.lastActiveDate == null;
      allow update: if isOwner(uid)
        && !changedKeys().hasAny(['username'])
        && xpDeltaOk()
        && streakDeltaOk()
        && lastActiveOk();
      allow delete: if false;
    }

    // --- Username registry (uniqueness) ---

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == username;
      allow update, delete: if false;
    }

    // --- Habits (owner-only) ---

    match /habits/{habitId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.archived == false;
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // --- Habit logs (owner-only; set once, deleted to untick) ---

    match /habit_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.habitId is string
        && request.resource.data.date is string
        && request.resource.data.completed == true
        && request.resource.data.xpEarned is int
        && request.resource.data.xpEarned >= 0
        && request.resource.data.xpEarned <= 10
        && logId == request.resource.data.habitId
            + '_' + request.resource.data.date;
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // --- Daily rewards: the +50 "all habits done" bonus, once per day ---

    match /daily_rewards/{rewardId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 50
        && rewardId == request.resource.data.ownerUid
            + '_' + request.resource.data.date;
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Weekly + monthly tasks (owner-only) ---

    match /weekly_tasks/{taskId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.weekStart is string
        && request.resource.data.done == false;
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /monthly_tasks/{taskId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.month is string
        && request.resource.data.done == false;
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // --- Follows (for the Friends leaderboard) ---

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.resource.data.followerUid
            + '_' + request.resource.data.followingUid;
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.followerUid == request.auth.uid;
    }
  }
}
